acerola.app {
    header {
        Strict-Transport-Security "max-age=31536000;"
    }

    # Swarm service of the hetzner_acerola stack, over the edge network. The app's own Caddy
    # (acerola/.config/docker/caddyfile) sets the cache and security headers.
    reverse_proxy hetzner_acerola_web:3000

    log {
        output file /data/acerola-access.log
        format json
    }
}

# One address only: www goes to the root domain.
www.acerola.app {
    redir https://acerola.app{uri} permanent
}
